{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in Herdr",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts test/*.test.ts",
    "test:integration": "node test/live-test-entrypoint.ts && node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:layout:integration": "node test/live-test-entrypoint.ts && node --test --test-concurrency=1 test/integration/pane-layout.test.ts",
    "test:provider:integration": "node test/live-test-entrypoint.ts && node --test --test-concurrency=1 --test-name-pattern=\"spawns a subagent that writes a file and verifies the session\" test/integration/subagent-lifecycle.test.ts",
    "test:deploy": "node --test test/deploy-active-package.test.ts",
    "deploy:active-package": "node scripts/deploy-active-package.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@sinclair/typebox": "^0.34.49"
  }
}
